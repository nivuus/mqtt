[Unit]
Description=MQTT System Agent (Packaged)
After=network.target
Documentation=https://github.com/your-repo/mqtt-system-agent

[Service]
Type=simple
ExecStart=/opt/mqtt-system-agent/mqtt-system-agent --config /opt/mqtt-system-agent/config/agent.yaml
WorkingDirectory=/opt/mqtt-system-agent
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=mqtt-system-agent
Restart=always
RestartSec=5
User=root
Environment=NODE_ENV=production
# Secrets live outside the package, in a root-only file (mode 600) that a .deb upgrade never
# touches: MQTT_USERNAME / MQTT_PASSWORD (the broker client; written by home-manager's install
# hook on a fresh install), NIVUUS_WS_TOKEN, NUT_USERNAME / NUT_PASSWORD.
# The "-" prefix makes the file optional: without it a missing file fails the unit before the
# agent starts (systemd.exec(5)). Its values override any Environment= line, drop-ins included.
EnvironmentFile=-/etc/mqtt-system-agent.env

# Security options - relaxed for debugging
NoNewPrivileges=no
PrivateTmp=false
ProtectSystem=false
# No ReadWritePaths: with ProtectSystem=false nothing is read-only, so it granted nothing, and
# a listed path that does not exist (a fresh install has no cache/) fails the unit with 226/NAMESPACE.
# The agent creates /opt/mqtt-system-agent/cache itself (OnlineMacVendorLookup).
ProtectHome=false

[Install]
WantedBy=multi-user.target
