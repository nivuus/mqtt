[Unit]
Description=MQTT System Agent (Packaged)
After=network.target
Documentation=https://github.com/your-repo/mqtt-system-agent

[Service]
Type=simple
ExecStart=/opt/mqtt-system-agent/mqtt-system-agent --config /opt/mqtt-system-agent/config/agent.yaml
WorkingDirectory=/opt/mqtt-system-agent
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=mqtt-system-agent
Restart=always
RestartSec=5
User=root
Environment=NODE_ENV=production
# Uncomment and set these to override MQTT credentials from config file:
# Environment=MQTT_USERNAME=mqtt
# Environment=MQTT_PASSWORD=your_secure_password_here

# Security options - relaxed for debugging
NoNewPrivileges=no
PrivateTmp=false
ProtectSystem=false
ReadWritePaths=/opt/mqtt-system-agent/cache
ProtectHome=false

[Install]
WantedBy=multi-user.target
